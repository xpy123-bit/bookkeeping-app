# 环境变量示例。复制成 .env 后填写。
#
# **没有这个文件应用也能完整跑通**：记账、账单导入、发票 XML 解析、自动分类、
# 报表、预算全部可用。这些变量只影响「登录」与「云端 OCR / 大模型」。

# ────────────────────────────────────────────────
# 服务基础配置
# ────────────────────────────────────────────────
PORT=8787

# 服务端自身的外部可访问地址。用于构造 OAuth 的 redirect_uri。
# ⚠️ 必须是这里配置的常量，**不能从请求头推导**（那是开放重定向漏洞）。
# 真实渠道联调时，该值必须与开放平台后台登记的域名一致，且公网可达。
SERVER_ORIGIN=http://127.0.0.1:8787

# 登录成功后要把用户送回的应用地址。
APP_ORIGIN=http://127.0.0.1:5173

# 服务端数据库位置（只存用户/身份/会话，**不存任何账本流水**）。
DB_PATH=data/bookkeeping.sqlite

# 部署到 GitHub Pages 时的子路径，例如 /bookkeeping-app/。
# 本地开发留空（根路径）。CI 会自动设置。
VITE_BASE=

# ────────────────────────────────────────────────
# 演示登录（开发用）
# ────────────────────────────────────────────────
# 设为 true 且 NODE_ENV 不是 production 时，会启用「本地演示登录」渠道。
# 它走的是**真实授权码流程**（不是绕过认证），因此可用来验证登录链路。
# 生产环境保持不设或设为 false —— 此时该渠道从注册表移除，路由根本不存在。
ENABLE_MOCK_LOGIN=

# ────────────────────────────────────────────────
# 登录：支付宝
# ────────────────────────────────────────────────
# 去 https://open.alipay.com 创建应用后获得。
# 个人实名账号即可创建应用；沙箱环境无需商业资质即可完整联调。
# 注意：个人账号拿不到昵称/头像（「获取会员信息」需企业认证），
# 只能拿到稳定的 user_id / open_id。
ALIPAY_APP_ID=
# RSA2 私钥。可以填多行 PEM，也可以填去掉 PEM 头的单行 base64。
ALIPAY_PRIVATE_KEY=
# true = 走沙箱，无需商业资质。默认即为 true。
# ⚠️ 网上流传的 openapi.alipaydev.com / openauth.alipaydev.com **已失效**，
#    正确地址是 openapi-sandbox.dl.alipaydev.com / openauth-sandbox.dl.alipaydev.com。
ALIPAY_SANDBOX=true

# ────────────────────────────────────────────────
# 登录：微信
# ────────────────────────────────────────────────
# 「网站应用微信登录」要求企业或个体工商户主体、公章、以及 ICP 备案域名，
# **个人主体无法通过应用审核**。未取得资质前这里留空。
# 协议实现已完整（含 unionid 与快照虚拟账号的处理），拿到资质即可启用。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ────────────────────────────────────────────────
# OCR（可选）
# ────────────────────────────────────────────────
# 推荐顺序：
#   1. 数电发票 → 走 XML 解析，**完全不需要 OCR**（应用已支持，零配置）
#   2. 本地 Umi-OCR → 免费、离线、票据不出本机（解压即用，开启 HTTP 服务即可）
#   3. 百度云 OCR → 个人认证 1000 次/月长期发放，无需 GPU
#
# 本地 Umi-OCR 的地址（默认已可用，通常无需修改）：
UMI_OCR_ENDPOINT=http://127.0.0.1:1224/api/ocr

# 百度 OCR（去 https://console.bce.baidu.com/ai/ 创建应用）
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ────────────────────────────────────────────────
# 大模型辅助分类（可选）
# ────────────────────────────────────────────────
# 规则引擎已离线可用，这里只是可选增强，**不是前置依赖**。
# 只处理规则未命中的长尾商户；失败时会降级，不影响账本。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
