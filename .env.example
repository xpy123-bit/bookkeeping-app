# 环境变量示例。
# 复制成 .env 后填写。**没有这个文件应用也能完整跑通记账、导入、分类、报表**，
# 这些变量只影响「登录」与「云端 OCR / 大模型」。

# ────────────────────────────────────────────────
# 登录：支付宝
# ────────────────────────────────────────────────
# 去 https://open.alipay.com 创建应用后获得。
# 个人实名账号即可创建应用；沙箱环境无需商业资质即可联调。
# 注意：个人账号拿不到昵称/头像（「获取会员信息」需企业认证），
# 只能拿到稳定的 user_id / open_id。
ALIPAY_APP_ID=
# RSA2 私钥（单行，不要带换行）。
ALIPAY_PRIVATE_KEY=
# 沙箱模式：true 时走 openapi-sandbox.dl.alipaydev.com。
# 注意：网上流传的 openapi.alipaydev.com 已失效（会返回 502）。
ALIPAY_SANDBOX=true
# 授权回调地址。必须与开放平台后台登记的完全一致（仅域名级别匹配）。
ALIPAY_REDIRECT_URI=http://127.0.0.1:8787/api/auth/callback/alipay

# ────────────────────────────────────────────────
# 登录：微信
# ────────────────────────────────────────────────
# 「网站应用微信登录」要求企业或个体工商户主体、公章、以及 ICP 备案域名，
# 个人主体无法通过应用审核。未取得资质前这里留空。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://127.0.0.1:8787/api/auth/callback/wechat

# ────────────────────────────────────────────────
# OCR（可选，未接入，仅规划）
# ────────────────────────────────────────────────
# 推荐：百度通用文字识别（高精度版），个人认证 1000 次/月长期发放。
# 注意：数电发票请走 XML 解析，完全不需要 OCR。
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# 本地 OCR 备选（Umi-OCR，解压即用，无需 API key）：
UMI_OCR_ENDPOINT=http://127.0.0.1:1224/api/ocr

# ────────────────────────────────────────────────
# 大模型自动分类（可选，未接入）
# ────────────────────────────────────────────────
# 规则引擎已离线可用，这里只是可选增强，不是前置依赖。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ────────────────────────────────────────────────
# 服务
# ────────────────────────────────────────────────
PORT=8787

# 部署到 GitHub Pages 时的子路径，例如 /bookkeeping-app/。
# 本地开发留空（根路径）。
VITE_BASE=
